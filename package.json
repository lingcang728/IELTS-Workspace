{
  "name": "ielts-workspace",
  "private": true,
  "version": "1.3.8",
  "description": "Local portable IELTS Academic computer-test workspace",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "package:release": "pwsh -NoProfile -File scripts/package-release.ps1",
    "test": "vitest run",
    "verify": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "build:site": "npm --prefix site run build",
    "dev:site": "npm --prefix site run dev"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
