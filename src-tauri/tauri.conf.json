{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IELTS Workspace",
  "mainBinaryName": "IELTS Workspace",
  "version": "1.3.7",
  "identifier": "com.linc.ielts-workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IELTS Workspace",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 http://localhost:1420 ws://localhost:1420 ws://127.0.0.1:1420; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/IELTS Workspace/data/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxM0VEN0JGOUNDMjY1QTQKUldTa1pjS2N2OWMrY2JPdUJpVDFBcTVrS2x1Szk2UHhMS2wwSlBpZHRlcUVxL1YzbGUybFFFRXcK",
      "endpoints": [
        "https://github.com/lingcang728/IELTS-Workspace/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
